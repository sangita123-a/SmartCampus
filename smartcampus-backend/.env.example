# Server
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/smartcampus?schema=public"

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Cookies (set true behind HTTPS in production)
COOKIE_SECURE=false

# Cloudinary (student profile images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
