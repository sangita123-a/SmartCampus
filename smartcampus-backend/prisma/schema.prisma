generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COLLEGE_ADMIN
  FACULTY
  STUDENT
  PARENT
  LIBRARIAN
  ACCOUNTANT
}

enum CollegeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum AcademicStatus {
  ACTIVE
  INACTIVE
}

enum CourseType {
  UNDERGRADUATE
  POSTGRADUATE
  DIPLOMA
  CERTIFICATE
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VISITING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum AttendanceMethod {
  MANUAL
  QR_CODE
  BIOMETRIC
}

enum RoomType {
  LECTURE_HALL
  LABORATORY
  SEMINAR_HALL
  AUDITORIUM
  OTHER
}

enum ClassroomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimetableStatus {
  ACTIVE
  INACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
  CHEQUE
  ONLINE_GATEWAY
}

enum ExamType {
  INTERNAL
  MID_SEMESTER
  PRACTICAL
  LAB
  ASSIGNMENT
  SEMESTER_END
  SUPPLEMENTARY
}

enum ExamStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ResultStatus {
  PASS
  FAIL
  ABSENT
  WITHHELD
}

enum BookStatus {
  AVAILABLE
  ISSUED
  RESERVED
  LOST
  DAMAGED
}

enum IssueStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  ANNOUNCEMENT
  CIRCULAR
  FEE_REMINDER
  ATTENDANCE_ALERT
  EXAM_NOTICE
  HOLIDAY_NOTICE
  ASSIGNMENT_NOTICE
  EMERGENCY_ALERT
  GENERAL
}

enum TargetAudience {
  ALL_USERS
  STUDENTS
  FACULTY
  PARENTS
  COLLEGE_ADMIN
  DEPARTMENT
  COURSE
  SEMESTER
  INDIVIDUAL_USER
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

model College {
  id                String           @id @default(cuid())
  name              String           @unique
  code              String           @unique
  email             String           @unique
  phone             String?
  address           String?
  website           String?
  logo              String?
  status            CollegeStatus    @default(ACTIVE)
  subscriptionPlan  SubscriptionPlan @default(FREE)
  subscriptionStart DateTime         @default(now())
  subscriptionEnd   DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  users             User[]
  departments       Department[]
  courses           Course[]
  students          Student[]
  faculty           Faculty[]
  subjects          Subject[]
  attendance        Attendance[]
  classrooms        Classroom[]
  timetables        Timetable[]
  feeCategories     FeeCategory[]
  feeStructures     FeeStructure[]
  exams             Exam[]
  bookCategories    BookCategory[]
  books             Book[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  activityLogs      ActivityLog[]
  systemSettings    SystemSetting[]
  backupRecords     BackupRecord[]

  subscriptions     Subscription[]
  invoices          Invoice[]
  provisioningLogs  TenantProvisioningLog[]
  aiConversations   AIConversation[]
  aiUsages          AIUsage[]
  aiSettings        AISetting[]

  @@index([status])
  @@index([subscriptionPlan])
  @@index([subscriptionEnd])
  @@map("colleges")
}

model User {
  id                   String                  @id @default(cuid())
  name                 String
  email                String                  @unique
  password             String
  role                 Role                    @default(STUDENT)
  isActive             Boolean                 @default(true)
  isVerified           Boolean                 @default(false)
  refreshToken         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLogin            DateTime?
  collegeId            String?
  college              College?                @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  studentProfile       Student?
  facultyProfile       Faculty?
  parentStudents       ParentStudent[]
  createdNotifications Notification[]          @relation("CreatedNotifications")
  notificationRecipients NotificationRecipient[]
  auditLogs            AuditLog[]
  activityLogs         ActivityLog[]
  aiConversations      AIConversation[]
  aiUsages             AIUsage[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([collegeId])
  @@index([refreshToken])
  @@index([role])
  @@map("users")
}

model Department {
  id            String         @id @default(cuid())
  collegeId     String
  name          String
  code          String
  description   String?
  status        AcademicStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  college       College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courses       Course[]
  students      Student[]
  faculty       Faculty[]
  subjects      Subject[]
  attendance    Attendance[]
  timetables    Timetable[]
  feeStructures FeeStructure[]
  exams         Exam[]

  @@unique([collegeId, name])
  @@unique([collegeId, code])
  @@index([collegeId])
  @@index([status])
  @@map("departments")
}

model Course {
  id            String         @id @default(cuid())
  departmentId  String
  collegeId     String
  name          String
  code          String
  duration      Int
  courseType    CourseType     @default(UNDERGRADUATE)
  description   String?
  status        AcademicStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  college       College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  semesters     Semester[]
  students      Student[]
  subjects      Subject[]
  attendance    Attendance[]
  timetables    Timetable[]
  feeStructures FeeStructure[]
  exams         Exam[]

  @@unique([collegeId, code])
  @@index([collegeId])
  @@index([departmentId])
  @@index([status])
  @@index([courseType])
  @@map("courses")
}

model Semester {
  id             String         @id @default(cuid())
  courseId       String
  semesterNumber Int
  name           String
  startDate      DateTime
  endDate        DateTime
  status         AcademicStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  students       Student[]
  subjects       Subject[]
  attendance     Attendance[]
  timetables     Timetable[]
  feeStructures  FeeStructure[]
  exams          Exam[]

  @@unique([courseId, semesterNumber])
  @@index([courseId])
  @@index([status])
  @@map("semesters")
}

model Student {
  id                 String             @id @default(cuid())
  studentId          String             @unique
  collegeId          String
  departmentId       String
  courseId           String
  semesterId         String
  userId             String?            @unique
  firstName          String
  lastName           String
  gender             Gender
  dateOfBirth        DateTime
  email              String
  phone              String
  address            String?
  city               String?
  state              String?
  country            String?
  pincode            String?
  bloodGroup         BloodGroup         @default(UNKNOWN)
  admissionDate      DateTime           @default(now())
  rollNumber         String
  registrationNumber String
  profileImage       String?
  status             StudentStatus      @default(ACTIVE)
  guardianName       String?
  guardianPhone      String?
  guardianEmail      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  college            College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department         Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  course             Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semester           Semester           @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendance         Attendance[]
  studentFees        StudentFee[]
  results            StudentResult[]
  bookIssues         BookIssue[]
  bookReservations   BookReservation[]
  parentStudents     ParentStudent[]

  @@unique([collegeId, email])
  @@unique([collegeId, rollNumber])
  @@unique([collegeId, registrationNumber])
  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([status])
  @@index([firstName])
  @@index([lastName])
  @@map("students")
}

model Faculty {
  id             String         @id @default(cuid())
  facultyId      String         @unique
  collegeId      String
  departmentId   String
  employeeId     String
  userId         String?        @unique
  firstName      String
  lastName       String
  email          String
  phone          String
  gender         Gender
  dateOfBirth    DateTime?
  qualification  String?
  experience     Int            @default(0)
  designation    String
  joiningDate    DateTime       @default(now())
  employmentType EmploymentType @default(FULL_TIME)
  salary         Decimal?       @db.Decimal(12, 2)
  bloodGroup     BloodGroup     @default(UNKNOWN)
  address        String?
  city           String?
  state          String?
  country        String?
  pincode        String?
  profileImage   String?
  status         FacultyStatus  @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  college        College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjects       Subject[]
  attendance     Attendance[]
  timetables     Timetable[]
  examSubjects   ExamSubject[]
  bookIssues     BookIssue[]

  @@unique([collegeId, email])
  @@unique([collegeId, employeeId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([status])
  @@index([designation])
  @@index([firstName])
  @@index([lastName])
  @@map("faculty")
}

model Subject {
  id             String          @id @default(cuid())
  subjectCode    String          @unique
  subjectName    String
  shortName      String?
  credits        Int
  theoryHours    Int             @default(0)
  practicalHours Int             @default(0)
  totalHours     Int             @default(0)
  departmentId   String
  courseId       String
  semesterId     String
  facultyId      String?
  collegeId      String
  description    String?
  status         AcademicStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semester       Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  faculty        Faculty?        @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  college        College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  attendance     Attendance[]
  timetables     Timetable[]
  examSubjects   ExamSubject[]
  studentResults StudentResult[]

  @@unique([semesterId, subjectName])
  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([facultyId])
  @@index([status])
  @@map("subjects")
}

model Attendance {
  id               String           @id @default(cuid())
  collegeId        String
  departmentId     String
  courseId         String
  semesterId       String
  subjectId        String
  facultyId        String
  studentId        String
  attendanceDate   DateTime         @db.Date
  attendanceStatus AttendanceStatus
  attendanceMethod AttendanceMethod @default(MANUAL)
  remarks          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  college    College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty    Faculty    @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, attendanceDate])
  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([subjectId])
  @@index([facultyId])
  @@index([studentId])
  @@index([attendanceDate])
  @@index([attendanceStatus])
  @@index([attendanceMethod])
  @@map("attendance")
}

model QRAttendanceSession {
  id           String   @id @default(cuid())
  collegeId    String
  departmentId String
  courseId     String
  semesterId   String
  subjectId    String
  facultyId    String
  sessionCode  String   @unique
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([collegeId])
  @@index([subjectId])
  @@index([sessionCode])
  @@map("qr_attendance_sessions")
}

model Classroom {
  id         String          @id @default(cuid())
  collegeId  String
  roomNumber String
  roomName   String
  building   String
  floor      Int             @default(1)
  capacity   Int
  roomType   RoomType        @default(LECTURE_HALL)
  status     ClassroomStatus @default(AVAILABLE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  college    College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  timetables Timetable[]

  @@unique([collegeId, roomNumber])
  @@index([collegeId])
  @@index([status])
  @@index([roomType])
  @@map("classrooms")
}

model Timetable {
  id           String          @id @default(cuid())
  collegeId    String
  departmentId String
  courseId     String
  semesterId   String
  subjectId    String
  facultyId    String
  classroomId  String
  dayOfWeek    DayOfWeek
  startTime    String
  endTime      String
  academicYear String          @default("2025-2026")
  status       TimetableStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  college    College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty    Faculty    @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  classroom  Classroom  @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([subjectId])
  @@index([facultyId])
  @@index([classroomId])
  @@index([dayOfWeek])
  @@index([status])
  @@map("timetables")
}

model FeeCategory {
  id            String         @id @default(cuid())
  collegeId     String
  name          String
  description   String?
  status        AcademicStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  college       College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]

  @@unique([collegeId, name])
  @@index([collegeId])
  @@map("fee_categories")
}

model FeeStructure {
  id            String         @id @default(cuid())
  collegeId     String
  departmentId  String
  courseId      String
  semesterId    String
  feeCategoryId String
  academicYear  String         @default("2025-2026")
  amount        Decimal        @db.Decimal(12, 2)
  dueDate       DateTime
  lateFeePerDay Decimal        @default(0) @db.Decimal(8, 2)
  status        AcademicStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  college     College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department  Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  feeCategory FeeCategory  @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)
  studentFees StudentFee[]

  @@unique([collegeId, departmentId, courseId, semesterId, feeCategoryId, academicYear])
  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([feeCategoryId])
  @@map("fee_structures")
}

model StudentFee {
  id                String        @id @default(cuid())
  studentId         String
  feeStructureId    String
  totalAmount       Decimal       @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  scholarshipAmount Decimal       @default(0) @db.Decimal(12, 2)
  fineAmount        Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(12, 2)
  remainingAmount   Decimal       @db.Decimal(12, 2)
  paymentStatus     PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@unique([studentId, feeStructureId])
  @@index([studentId])
  @@index([feeStructureId])
  @@index([paymentStatus])
  @@map("student_fees")
}

model Payment {
  id            String        @id @default(cuid())
  studentFeeId  String
  receiptNumber String        @unique
  paymentMethod PaymentMethod @default(CASH)
  transactionId String?
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime      @default(now())
  paymentStatus PaymentStatus @default(PAID)
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  @@index([studentFeeId])
  @@index([receiptNumber])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@map("payments")
}

model Exam {
  id           String     @id @default(cuid())
  collegeId    String
  departmentId String
  courseId     String
  semesterId   String
  examName     String
  examType     ExamType   @default(SEMESTER_END)
  academicYear String     @default("2025-2026")
  startDate    DateTime
  endDate      DateTime
  status       ExamStatus @default(SCHEDULED)
  isPublished  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  college      College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semester     Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  examSubjects ExamSubject[]
  results      StudentResult[]

  @@unique([collegeId, semesterId, examName, academicYear])
  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([status])
  @@index([isPublished])
  @@map("exams")
}

model ExamSubject {
  id           String    @id @default(cuid())
  examId       String
  subjectId    String
  facultyId    String?
  maxMarks     Decimal   @default(100) @db.Decimal(5, 2)
  passingMarks Decimal   @default(40) @db.Decimal(5, 2)
  examDate     DateTime  @db.Date
  startTime    String
  endTime      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@unique([examId, subjectId])
  @@index([examId])
  @@index([subjectId])
  @@index([facultyId])
  @@map("exam_subjects")
}

model StudentResult {
  id            String       @id @default(cuid())
  studentId     String
  examId        String
  subjectId     String
  obtainedMarks Decimal      @db.Decimal(5, 2)
  grade         String
  gradePoint    Decimal      @db.Decimal(4, 2)
  resultStatus  ResultStatus @default(PASS)
  remarks       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([studentId, examId, subjectId])
  @@index([studentId])
  @@index([examId])
  @@index([subjectId])
  @@index([resultStatus])
  @@map("student_results")
}

model BookCategory {
  id          String         @id @default(cuid())
  collegeId   String
  name        String
  description String?
  status      AcademicStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  books   Book[]

  @@unique([collegeId, name])
  @@index([collegeId])
  @@map("book_categories")
}

model Author {
  id        String   @id @default(cuid())
  name      String   @unique
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]

  @@map("authors")
}

model Publisher {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]

  @@map("publishers")
}

model Book {
  id              String       @id @default(cuid())
  collegeId       String
  categoryId      String
  authorId        String
  publisherId     String
  isbn            String       @unique
  title           String
  edition         String?
  language        String       @default("English")
  publicationYear Int?
  totalCopies     Int          @default(1)
  availableCopies  Int          @default(1)
  rackNumber      String?
  shelfNumber     String?
  coverImage      String?
  description     String?
  status          BookStatus   @default(AVAILABLE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  college      College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  category     BookCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author       Author            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publisher    Publisher         @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  issues       BookIssue[]
  reservations BookReservation[]

  @@index([collegeId])
  @@index([categoryId])
  @@index([authorId])
  @@index([publisherId])
  @@index([isbn])
  @@index([status])
  @@map("books")
}

model BookIssue {
  id          String      @id @default(cuid())
  bookId      String
  studentId   String?
  facultyId   String?
  issueDate   DateTime    @default(now())
  dueDate     DateTime
  returnDate  DateTime?
  fineAmount  Decimal     @default(0) @db.Decimal(10, 2)
  status      IssueStatus @default(ISSUED)
  remarks     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([studentId])
  @@index([facultyId])
  @@index([status])
  @@map("book_issues")
}

model BookReservation {
  id              String            @id @default(cuid())
  bookId          String
  studentId       String
  reservationDate DateTime          @default(now())
  expiryDate      DateTime
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([studentId])
  @@index([status])
  @@map("book_reservations")
}

model ParentStudent {
  id                String   @id @default(cuid())
  parentId          String
  studentId         String
  relationship      String   @default("GUARDIAN")
  isPrimaryGuardian Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_students")
}

model Notification {
  id             String               @id @default(cuid())
  collegeId      String
  title          String
  message        String               @db.Text
  notificationType NotificationType   @default(ANNOUNCEMENT)
  targetAudience TargetAudience       @default(ALL_USERS)
  targetId       String?
  priority       NotificationPriority @default(MEDIUM)
  status         NotificationStatus   @default(SENT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdBy      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  college    College                 @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  creator    User                    @relation("CreatedNotifications", fields: [createdBy], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([collegeId])
  @@index([createdBy])
  @@index([notificationType])
  @@index([targetAudience])
  @@index([priority])
  @@index([status])
  @@map("notifications")
}

model NotificationRecipient {
  id             String         @id @default(cuid())
  notificationId String
  userId         String
  isRead         Boolean        @default(false)
  readAt         DateTime?
  deliveryStatus DeliveryStatus @default(DELIVERED)
  createdAt      DateTime       @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([notificationId])
  @@index([userId])
  @@index([isRead])
  @@index([deliveryStatus])
  @@map("notification_recipients")
}

// ─── Production Optimization & Enterprise Security ────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ROLE_CHANGE
  PAYMENT_ACTIVITY
  EXAM_PUBLISH
  ATTENDANCE_UPDATE
  PASSWORD_CHANGE
  SETTINGS_CHANGE
  BACKUP_TRIGGER
  EXPORT
}

enum BackupType {
  MANUAL
  SCHEDULED
  CLOUD
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model AuditLog {
  id           String      @id @default(cuid())
  collegeId    String?
  userId       String?
  module       String
  action       AuditAction
  resourceType String?
  resourceId   String?
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  device       String?
  browser      String?
  createdAt    DateTime    @default(now())

  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@index([collegeId, module, action])
  @@map("audit_logs")
}

model ActivityLog {
  id          String   @id @default(cuid())
  collegeId   String?
  userId      String?
  module      String
  action      String
  description String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@index([userId, module])
  @@map("activity_logs")
}

model SystemSetting {
  id          String   @id @default(cuid())
  collegeId   String?
  category    String
  key         String
  value       Json
  description String?
  isEditable  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, category, key])
  @@index([collegeId])
  @@index([category])
  @@map("system_settings")
}

model BackupRecord {
  id          String       @id @default(cuid())
  collegeId   String?
  filename    String
  size        BigInt       @default(0)
  type        BackupType   @default(MANUAL)
  status      BackupStatus @default(PENDING)
  path        String?
  notes       String?
  createdBy   String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("backup_records")
}

// ─── Commercial SaaS Platform Models ──────────────────────────────────

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FLAT
}

enum ContactType {
  GENERAL
  SUPPORT
  DEMO
  SALES
}

model SaasPlan {
  id           String         @id @default(cuid())
  name         String         @unique // Starter, Professional, Business, Enterprise
  code         String         @unique // starter, pro, business, enterprise
  description  String?
  monthlyPrice Decimal        @db.Decimal(10, 2)
  yearlyPrice  Decimal        @db.Decimal(10, 2)
  userLimit    Int            @default(100)
  storageLimit Int            @default(5) // in GB
  features     Json           // List of feature strings/flags
  isPopular    Boolean        @default(false)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("saas_plans")
}

model Subscription {
  id           String             @id @default(cuid())
  collegeId    String
  planId       String?
  planName     String             // Starter, Professional, Business, Enterprise
  billingCycle BillingCycle       @default(MONTHLY)
  status       SubscriptionStatus @default(TRIALING)
  amount       Decimal            @db.Decimal(10, 2)
  currency     String             @default("USD")
  startDate    DateTime           @default(now())
  endDate      DateTime
  trialEndsAt  DateTime?
  autoRenew    Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  college College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  plan    SaasPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  invoices Invoice[]

  @@index([collegeId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  collegeId      String
  subscriptionId String?
  amount         Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  status         InvoiceStatus @default(PENDING)
  paymentMethod  String?       // razorpay, stripe, cash
  paymentId      String?
  dueDate        DateTime
  paidAt         DateTime?
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  college      College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([subscriptionId])
  @@index([invoiceNumber])
  @@index([status])
  @@map("invoices")
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  discountType CouponType  @default(PERCENTAGE)
  discountValue Decimal    @db.Decimal(10, 2)
  maxUses     Int?
  usedCount   Int          @default(0)
  expiryDate  DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  redemptions CouponRedemption[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  collegeId String
  redeemedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, collegeId])
  @@map("coupon_redemptions")
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  content     String   @db.Text
  category    String
  tags        String[]
  authorName  String
  authorRole  String?
  coverImage  String?
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@map("blog_posts")
}

model ContactSubmission {
  id        String      @id @default(cuid())
  name      String
  email     String
  phone     String?
  college   String?
  type      ContactType @default(GENERAL)
  message   String      @db.Text
  isResolved Boolean    @default(false)
  createdAt DateTime    @default(now())

  @@index([type])
  @@index([email])
  @@map("contact_submissions")
}

model TenantProvisioningLog {
  id        String   @id @default(cuid())
  collegeId String
  tenantCode String
  status    String   // SUCCESS, FAILED
  details   Json?
  createdAt DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([tenantCode])
  @@map("tenant_provisioning_logs")
}

// ─── AI SmartCampus Module Models ──────────────────────────────────────

enum AIMessageSender {
  USER
  ASSISTANT
  SYSTEM
}

enum AIFeatureKey {
  CHATBOT
  STUDENT_PERFORMANCE_PREDICTION
  ATTENDANCE_INSIGHTS
  FEE_INSIGHTS
  TIMETABLE_ASSISTANT
  EXAM_INSIGHTS
  NOTIFICATION_GENERATOR
  REPORT_SUMMARIZER
  NATURAL_LANGUAGE_SEARCH
  ANALYTICS_ASSISTANT
}

model AIConversation {
  id        String      @id @default(cuid())
  collegeId String?
  userId    String
  title     String      @default("New Conversation")
  feature   AIFeatureKey @default(CHATBOT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  college  College?    @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([collegeId])
  @@index([userId])
  @@index([feature])
  @@map("ai_conversations")
}

model AIMessage {
  id             String          @id @default(cuid())
  conversationId String
  sender         AIMessageSender
  content        String          @db.Text
  tokensUsed     Int             @default(0)
  createdAt      DateTime        @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model AIPrompt {
  id          String       @id @default(cuid())
  featureKey  AIFeatureKey @unique
  name        String
  description String?
  systemPrompt String      @db.Text
  userTemplate String      @db.Text
  isEditable  Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("ai_prompts")
}

model AIUsage {
  id           String       @id @default(cuid())
  collegeId    String?
  userId       String
  feature      AIFeatureKey
  promptTokens Int          @default(0)
  completionTokens Int      @default(0)
  totalTokens  Int          @default(0)
  costEstimate Decimal      @default(0) @db.Decimal(10, 5)
  modelUsed    String       @default("gpt-4o-mini")
  createdAt    DateTime     @default(now())

  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@map("ai_usages")
}

model AISetting {
  id               String   @id @default(cuid())
  collegeId        String?  // null = global super admin setting
  isEnabled        Boolean  @default(true)
  modelProvider    String   @default("openai") // openai, gemini, anthropic, ollama
  modelName        String   @default("gpt-4o-mini")
  apiKey           String?  // encrypted or masked API key override
  apiBaseUrl       String?  // custom OpenAI-compatible endpoint URL
  rateLimitPerMin  Int      @default(60)
  maxTokensPerReq  Int      @default(2048)
  enabledFeatures  Json     // Map of AIFeatureKey -> boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  college College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId])
  @@index([collegeId])
  @@map("ai_settings")
}


